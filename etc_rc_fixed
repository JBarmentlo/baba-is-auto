mkdir -p "/app" 2> /dev/null
cd "/app" && unset OLDPWD || exit 1

if [ -s /etc/rc.local ]; then
    . /etc/rc.local
fi

if [ $# -gt 0 ]; then
    exec  "$@"
else
    exec  '/opt/venv/bin/python' '-m' 'baba_mcp.server'
fi
