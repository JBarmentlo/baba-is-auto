# BabaMCP — HTTP MCP server wrapping the pyBaba "Baba Is You" simulator.
#
# Build:  podman build -f Dockerfile.mcp -t baba-mcp:latest .
# Run:    podman run -e BABA_MCP_PORT=8000 -p 8000:8000 baba-mcp:latest
#
# The server listens on HTTP (streamable-http) at 0.0.0.0:$BABA_MCP_PORT/mcp.
# Clients select an independent game via the `baba_session_id` request header.
FROM ubuntu:26.04
LABEL maintainer="JBarmentlo"

# Build + runtime toolchain. zip + autotools are required by several vcpkg ports.
RUN apt-get update && apt-get install -y \
    autoconf \
    autoconf-archive \
    automake \
    build-essential \
    curl \
    git \
    libtool \
    ninja-build \
    pkg-config \
    python3-dev \
    python3-pip \
    python3-setuptools \
    python3-venv \
    tar \
    unzip \
    zip \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# cmake >= 3.31.6 (Ubuntu's apt cmake is older), installed into an isolated venv.
ENV CMAKE_VENV=/opt/cmake-venv
RUN python3 -m venv ${CMAKE_VENV} && \
    ${CMAKE_VENV}/bin/pip install "cmake>=3.31.6"
ENV PATH="${CMAKE_VENV}/bin:${PATH}"

# vcpkg toolchain (provides pybind11, doctest, effolkronium-random).
ENV VCPKG_ROOT=/opt/vcpkg
ENV VCPKG_EXTRA_CURL_OPTS="-k"
RUN git clone https://github.com/microsoft/vcpkg.git ${VCPKG_ROOT} && \
    ${VCPKG_ROOT}/bootstrap-vcpkg.sh

# uv provides a reproducible standalone CPython. We pin one interpreter for BOTH
# building and running pyBaba so the module ABI always matches (the base image's
# system python is a different version, which is what caused ABI mismatches).
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

ENV BABA_VENV=/opt/venv
ENV BABA_PYTHON=3.12
RUN uv venv ${BABA_VENV} --python ${BABA_PYTHON} && \
    uv pip install --python ${BABA_VENV} setuptools wheel pybind11 "mcp>=1.8"

COPY . /app
WORKDIR /app

# Build the pyBaba extension against the venv interpreter via setup.py
# (build_ext --inplace -> /app/pyBaba.cpython-3XX-*.so at the repo root, which
# the server adds to sys.path). cmake + the vcpkg toolchain come from PATH /
# VCPKG_ROOT set above. The import check fails the build fast on any ABI mismatch.
RUN ${BABA_VENV}/bin/python setup.py build_ext --inplace && \
    ${BABA_VENV}/bin/python -c "import sys; sys.path.insert(0,'/app'); import pyBaba; print('pyBaba import OK for', sys.version.split()[0])"

# Drop build-only artifacts to shrink the exported rootfs / .sqsh. Runtime needs
# only /opt/venv (+ its interpreter base under /root/.local/share/uv/python) and
# /app; the vcpkg tree, cmake venv, and caches are build-time only. (Done in a
# trailing layer: `docker export` / `enroot import` flatten the rootfs, so the
# removed files are absent from the .sqsh even though image layers keep them.)
RUN rm -rf /opt/vcpkg /opt/cmake-venv /app/build /root/.cache /root/.local/bin \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && /opt/venv/bin/python -c "import sys; sys.path.insert(0,'/app'); import pyBaba; print('post-clean pyBaba OK', sys.version.split()[0])"

# HTTP transport; port is overridable at runtime via BABA_MCP_PORT.
ENV BABA_MCP_TRANSPORT=http \
    BABA_MCP_HOST=0.0.0.0 \
    BABA_MCP_PORT=8000 \
    BABA_MCP_HTTP_PATH=/mcp \
    PYTHONPATH=/app/Extensions/BabaMCP \
    PYTHONUNBUFFERED=1

EXPOSE 8000
CMD ["/opt/venv/bin/python", "-m", "baba_mcp.server"]

# Override the ubuntu base image's MULTI-LINE org.opencontainers.image.description
# label with a single line. enroot import only comments the first physical line of
# a multi-line label when generating /etc/rc, so the continuation lines leak in as
# executable shell and break container startup under pyxis (exit 127). This value
# MUST stay on ONE line with no embedded newlines. (Placed last to preserve build
# cache; label order does not affect the final merged image config.)
LABEL org.opencontainers.image.description="BabaMCP: pyBaba Baba Is You HTTP MCP server"
