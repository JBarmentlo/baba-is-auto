# BabaMCP — HTTP MCP server over the pure-Python canonical Baba Is You engine.
#
# Pure Python now (no C++/vcpkg), so the image is tiny and builds in seconds.
#
# Build:  docker build -f Dockerfile.mcp -t baba-mcp:latest .
# Run:    docker run -e BABA_MCP_PORT=8000 -p 8000:8000 baba-mcp:latest
#
# Serves streamable-http at 0.0.0.0:$BABA_MCP_PORT/mcp; clients select a game via
# the `baba_session_id` request header.
FROM python:3.12-slim
LABEL maintainer="JBarmentlo"

WORKDIR /app
COPY Extensions/Baba /app/Extensions/Baba
COPY Extensions/BabaMCP /app/Extensions/BabaMCP
COPY Resources/Maps /app/Resources/Maps

# Install the engine (+ its deps) and mcp, then the server itself (no re-resolve).
RUN pip install --no-cache-dir /app/Extensions/Baba "mcp>=1.8" \
    && pip install --no-cache-dir --no-deps /app/Extensions/BabaMCP \
    && python -c "import baba, baba_mcp; print('baba+baba_mcp import OK')"

ENV BABA_MCP_TRANSPORT=http \
    BABA_MCP_HOST=0.0.0.0 \
    BABA_MCP_PORT=8000 \
    BABA_MCP_HTTP_PATH=/mcp \
    BABA_REPO_ROOT=/app \
    PYTHONUNBUFFERED=1

EXPOSE 8000
CMD ["baba-mcp"]

# Single-line description so enroot's /etc/rc parser doesn't choke (see history).
LABEL org.opencontainers.image.description="BabaMCP: canonical Baba Is You HTTP MCP server"
